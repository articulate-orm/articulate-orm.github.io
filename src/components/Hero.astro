---
import { Image } from 'astro:assets';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

// Split "Articulate" into its slices for the scroll-driven title animation.
// Falls back to the plain title on any other page that happens to set a hero.
const isArticulateTitle = title === 'Articulate';
const slices = isArticulateTitle ? ['Art', 'icul', 'ate'] : null;
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			{
				slices ? (
					<h1 id="_top" data-page-title class="slice-title" aria-label={title}>
						<span class="slice slice-1" aria-hidden="true">{slices[0]}</span><span class="slice slice-2" aria-hidden="true">{slices[1]}</span><span class="slice slice-3" aria-hidden="true">{slices[2]}</span>
					</h1>
				) : (
					<h1 id="_top" data-page-title set:html={title} />
				)
			}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<a
								href={href}
								class:list={['sl-flex action', `${variant ?? 'primary'}`, className]}
								{...attrs}
							>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</a>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<script>
	const title = document.querySelector('.slice-title');
	const s1 = title?.querySelector('.slice-1');
	const s2 = title?.querySelector('.slice-2');
	const s3 = title?.querySelector('.slice-3');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (title && s1 && s2 && s3 && !reduceMotion) {
		let ticking = false;
		const update = () => {
			ticking = false;
			const progress = Math.min(1, Math.max(0, window.scrollY / 420));
			s2.style.transform = `translateX(${progress * 28}px)`;
			s3.style.transform = `translateX(${progress * 72}px)`;
			const hue = 220 + progress * 60;
			s1.style.color = `hsl(${hue}, 85%, ${65 - progress * 10}%)`;
			title.style.setProperty('--slice-gap', `${progress * 0.35}em`);
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		update();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.slice-title {
			display: inline-flex;
			gap: var(--slice-gap, 0em);
			white-space: nowrap;
		}

		.slice {
			display: inline-block;
			will-change: transform;
			transition: transform 0.05s linear;
		}

		.slice-1 {
			transition: color 0.05s linear;
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.action {
			align-items: center;
			gap: 0.5rem;
			padding: 0.375rem 1rem;
			border-radius: 999rem;
			font-weight: 600;
			text-decoration: none;
			border: 1px solid transparent;
		}

		.action.primary {
			background-color: var(--sl-color-accent);
			color: var(--sl-color-white);
		}

		.action.secondary {
			border-color: var(--sl-color-gray-5);
			color: var(--sl-color-white);
		}

		.action.minimal {
			color: var(--sl-color-gray-2);
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
