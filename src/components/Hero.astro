---
import { Image } from 'astro:assets';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

// Split "Articulate" into Art / iculate for the scroll-driven slice-cut animation.
// Falls back to the plain title on any other page that happens to set a hero.
const isArticulateTitle = title === 'Articulate';
const slices = isArticulateTitle ? ['Art', 'iculate'] : null;
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			{
				slices ? (
					<h1 id="_top" data-page-title class="slice-title" aria-label={title}>
						<span class="slice slice-1" aria-hidden="true">{slices[0]}<span class="cut-blade" aria-hidden="true"></span><span class="cut-glint" aria-hidden="true"></span></span><span class="slice slice-2" aria-hidden="true">{slices[1]}</span>
					</h1>
				) : (
					<h1 id="_top" data-page-title set:html={title} />
				)
			}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<a
								href={href}
								class:list={['sl-flex action', `${variant ?? 'primary'}`, className]}
								{...attrs}
							>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</a>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<script>
	const title = document.querySelector('.slice-title');
	const blade = title?.querySelector('.cut-blade');
	const glint = title?.querySelector('.cut-glint');
	const s2 = title?.querySelector('.slice-2');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (title && blade && glint && s2) {
		if (reduceMotion) {
			// Skip straight to the end state: no flash, no glint, iculate already settled below-left.
			title.classList.add('is-cut');
		} else {
			// Fire once on load, after the entrance transition has a beat to settle.
			requestAnimationFrame(() => {
				setTimeout(() => {
					blade.classList.add('flash');
					setTimeout(() => {
					    title.classList.add('is-cut');
						// Sun-glint flare once the cut has landed and iculate has settled.
						glint.classList.add('flare');
					}, 550);
                    setTimeout(() => blade.classList.add('settled'), 150);
				}, 300);
			});
		}
	}
</script>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.slice-title {
			display: inline-flex;
			align-items: baseline;
			white-space: nowrap;
			position: relative;
		}

		.slice {
			display: inline-block;
			position: relative;
		}

		/* Chromium sometimes fails to repaint gradient/background-clip:text
		   content on a transformed child until something forces a new
		   composite layer — the layout box moves (DevTools shows it) but the
		   painted glyphs visually lag behind. Force its own layer up front. */
		.slice-2 {
			will-change: transform;
			backface-visibility: hidden;
			transform: translate3d(0, 0, 0);
		}

		.cut-blade {
			position: absolute;
			top: -14%;
			bottom: -14%;
			right: -0.03em;
			width: 0.05em;
			border-radius: 999rem;
			/* Pure white core — not var(--sl-color-white), which is a text-color
			   token that reads as near-black in the light theme. */
			background: linear-gradient(180deg, transparent, #ffffff, transparent);
			opacity: 0;
			pointer-events: none;
			transform: rotate(10deg);
			transform-origin: center;
			transition: opacity 0.4s ease 0.5s;
		}

		.cut-blade.flash {
			animation: blade-flash 0.5s ease-out forwards;
		}

		/* The blade is a brief overlay — it fades away after firing. */
		.cut-blade.settled {
			opacity: 0 !important;
		}

		@keyframes blade-flash {
			0% {
				opacity: 0;
				transform: rotate(10deg) scaleY(0.4);
				box-shadow: none;
			}
			40% {
				opacity: 1;
				transform: rotate(10deg) scaleY(1.15);
				box-shadow: 0 0 16px 3px #ffffff, 0 0 30px 8px var(--sl-color-accent);
			}
			100% {
				opacity: 1;
				transform: rotate(10deg) scaleY(1);
				box-shadow: 0 0 6px 1px var(--sl-color-accent);
			}
		}

		/* Sun-glint: a small starburst that flares once at the cut point once
		   iculate has settled — reads as a flash of light catching the blade. */
		.cut-glint {
			position: absolute;
			top: 50%;
			right: -0.03em;
			width: 1.6em;
			height: 1.6em;
			transform: translate(50%, -50%) scale(0);
			pointer-events: none;
			opacity: 0;
			/* Rays fade through the accent color rather than plain white, so the
			   glint reads against a light-theme (near-white) hero background
			   instead of disappearing as white-on-white. */
			background:
				radial-gradient(circle, #ffffff 0%, rgba(255, 255, 255, 0.85) 14%, transparent 55%),
				linear-gradient(90deg, transparent 44%, var(--sl-color-accent) 48%, #ffffff 50%, var(--sl-color-accent) 52%, transparent 56%),
				linear-gradient(0deg, transparent 44%, var(--sl-color-accent) 48%, #ffffff 50%, var(--sl-color-accent) 52%, transparent 56%),
				linear-gradient(45deg, transparent 45%, var(--sl-color-accent) 48.5%, #ffffff 50%, var(--sl-color-accent) 51.5%, transparent 55%),
				linear-gradient(135deg, transparent 45%, var(--sl-color-accent) 48.5%, #ffffff 50%, var(--sl-color-accent) 51.5%, transparent 55%);
			filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.25));
		}

		:root[data-theme='dark'] .cut-glint {
			filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.4));
		}

		.cut-glint.flare {
			animation: glint-flare 0.6s ease-out forwards;
		}

		@keyframes glint-flare {
			0% {
				opacity: 0;
				transform: translate(50%, -50%) scale(0.2);
			}
			35% {
				opacity: 1;
				transform: translate(50%, -50%) scale(1);
			}
			100% {
				opacity: 0;
				transform: translate(50%, -50%) scale(1.6);
			}
		}

		.slice-2 {
			transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s;
		}

		.slice-title.is-cut .slice-2 {
			transform: translate3d(-0.05em, 0.25em, 0);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.action {
			align-items: center;
			gap: 0.5rem;
			padding: 0.375rem 1rem;
			border-radius: 999rem;
			font-weight: 600;
			text-decoration: none;
			border: 1px solid transparent;
		}

		.action.primary {
			background-color: #0f172a;
			color: #ffffff;
		}

		:root[data-theme='dark'] .action.primary {
			background-color: #05070d;
			color: #ffffff;
		}

		.action.secondary {
			border-color: var(--sl-color-gray-5);
			color: var(--sl-color-white);
		}

		.action.minimal {
			color: var(--sl-color-gray-2);
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
